{%- comment -%} Radar du ciel — vue quadrant (généré, ne pas modifier : voir trmnl/src) {%- endcomment -%}
{%- assign sz = "quadrant" -%}{%- assign n = 1 -%}{%- assign narrow = true -%}{%- assign short = true -%}
{%- assign st = trmnl.plugin_settings.custom_fields_values.style | default: "classique" | downcase -%}
{%- assign shown = flights.size | default: 0 -%}
{%- if shown > n -%}{%- assign shown = n -%}{%- endif -%}
{%- assign blanks = n | minus: shown -%}
{%- assign t = track -%}
{%- assign total_n = total | default: 0 -%}
{%- assign vue_raw = trmnl.plugin_settings.custom_fields_values.suivi_affichage | default: suivi_affichage | default: "tableau" | downcase -%}
{%- if vue_raw contains "carte" -%}{%- assign vue = "carte" -%}{%- elsif vue_raw contains "fiche" -%}{%- assign vue = "fiche" -%}{%- else -%}{%- assign vue = "tableau" -%}{%- endif -%}
{%- assign carte_raw = trmnl.plugin_settings.custom_fields_values.style_carte | default: style_carte | default: "outline" | downcase -%}
{%- if carte_raw contains "street" or carte_raw contains "rue" -%}{%- assign preset = "streets" -%}{%- elsif carte_raw contains "minimal" -%}{%- assign preset = "minimal" -%}{%- elsif carte_raw contains "blank" or carte_raw contains "pur" -%}{%- assign preset = "blank" -%}{%- else -%}{%- assign preset = "outline" -%}{%- endif -%}
{%- assign dd = t.d -%}
{%- assign zvue_raw = trmnl.plugin_settings.custom_fields_values.zone_affichage | default: zone_affichage | default: "tableau" | downcase -%}
{%- if zvue_raw contains "carte" -%}{%- assign zvue = "carte" -%}{%- else -%}{%- assign zvue = "tableau" -%}{%- endif -%}
{%- capture title_line -%}{% if mode == "suivi" %}Suivi {{ t.flight }}{% else %}{{ place_short }} · {{ total_n }} avion{% if total_n > 1 %}s{% endif %} à {{ radius_km }} km{% endif %} · {{ updated_txt }}{% if stale %} (ancien){% endif %}{%- endcapture -%}

{%- if mode == "suivi" and vue == "fiche" and dd and short != true -%}
{%- comment -%} ===================== FICHE DÉTAILLÉE DU VOL ===================== {%- endcomment -%}
<div class="layout layout--col layout--top layout--stretch-x gap">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <div class="flex flex--col">
      <span class="value {% if narrow %}value--small{% else %}value--medium{% endif %}">{{ t.flight }}{% if t.has_route %} · {{ t.from }} – {{ t.to }}{% endif %}</span>
      <span class="label" data-clamp="1">{{ dd.airline }}{% if dd.callsign != "" %} · {{ dd.callsign }}{% endif %}</span>
    </div>
    <div class="flex flex--col text--right flex--right">
      <span class="label label--inverted">{% if dd.emergency %}URGENCE {{ dd.squawk_txt }}{% else %}{{ t.status_txt }}{% endif %}</span>
      {% if t.route_doubt %}<span class="label label--small">route incertaine</span>{% elsif t.progress_pct != nil %}<span class="label label--small">{{ t.progress_pct }} % du trajet</span>{% endif %}
    </div>
  </div>
  <div class="divider"></div>
  <div class="grid grid--cols-{% if narrow %}1{% else %}3{% endif %} gap--medium w--full">
    <div class="flex flex--col gap--small">
      <span class="title title--small">Vol</span>
      <table class="table table--xsmall" data-table-limit="true"><tbody>
        {%- if t.has_route -%}
        <tr><td><span class="label label--small">Départ</span></td><td><span class="label label--small" data-clamp="2">{{ dd.from_name | default: t.from_city }}{% if dd.from_country != "" %} ({{ dd.from_country }}){% endif %}</span></td></tr>
        <tr><td><span class="label label--small">Arrivée</span></td><td><span class="label label--small" data-clamp="2">{{ dd.to_name | default: t.to_city }}{% if dd.to_country != "" %} ({{ dd.to_country }}){% endif %}</span></td></tr>
        {%- endif -%}
        {%- if dd.dist_total_txt and dd.dist_total_txt != "" -%}<tr><td><span class="label label--small">Distance</span></td><td><span class="label label--small">{{ dd.dist_total_txt }} km</span></td></tr>{%- endif -%}
        {%- if dd.takeoff_txt and dd.takeoff_txt != "" -%}<tr><td><span class="label label--small">Décollage</span></td><td><span class="label label--small">vers {{ dd.takeoff_txt }}{% if dd.elapsed_txt != "" %} ({{ dd.elapsed_txt }}){% endif %}</span></td></tr>{%- endif -%}
        {%- if t.eta_txt != "" -%}<tr><td><span class="label label--small">Arrivée prévue</span></td><td><span class="label label--small">vers {{ t.eta_txt }}{% if dd.remaining_time_txt != "" %} (dans {{ dd.remaining_time_txt }}){% endif %}</span></td></tr>{%- endif -%}
        {%- if t.remaining_km and t.remaining_km > 0 -%}<tr><td><span class="label label--small">Reste</span></td><td><span class="label label--small">{{ t.remaining_txt }} km</span></td></tr>{%- endif -%}
      </tbody></table>
    </div>
    <div class="flex flex--col gap--small">
      <span class="title title--small">Appareil</span>
      <table class="table table--xsmall" data-table-limit="true"><tbody>
        {%- if dd.model and dd.model != "" -%}<tr><td><span class="label label--small">Modèle</span></td><td><span class="label label--small" data-clamp="2">{{ dd.model }}</span></td></tr>{%- endif -%}
        {%- if dd.reg and dd.reg != "" -%}<tr><td><span class="label label--small">Immatriculation</span></td><td><span class="label label--small">{{ dd.reg }}</span></td></tr>{%- endif -%}
        {%- if dd.owner and dd.owner != "" -%}<tr><td><span class="label label--small">Exploitant</span></td><td><span class="label label--small" data-clamp="2">{{ dd.owner }}{% if dd.owner_country != "" %} ({{ dd.owner_country }}){% endif %}</span></td></tr>{%- endif -%}
        {%- if dd.category and dd.category != "" -%}<tr><td><span class="label label--small">Catégorie</span></td><td><span class="label label--small">{{ dd.category }}</span></td></tr>{%- endif -%}
        {%- if dd.hex and dd.hex != "" -%}<tr><td><span class="label label--small">Code Mode S</span></td><td><span class="label label--small">{{ dd.hex }}</span></td></tr>{%- endif -%}
      </tbody></table>
      {%- if dd.photo and dd.photo != "" and narrow != true -%}
      <img class="image image-dither image--cover w--full h--[90px] rounded--small" src="{{ dd.photo }}">
      {%- endif -%}
    </div>
    {%- unless narrow -%}
    <div class="flex flex--col gap--small">
      <span class="title title--small">En ce moment</span>
      <table class="table table--xsmall" data-table-limit="true"><tbody>
        {%- if t.over_txt and t.over_txt != "" -%}<tr><td><span class="label label--small">Survole</span></td><td><span class="label label--small" data-clamp="2">{{ t.over_txt }}</span></td></tr>{%- endif -%}
        <tr><td><span class="label label--small">Altitude</span></td><td><span class="label label--small">{{ t.alt_txt }} m{% if dd.alt_sel_txt != "" %} (visée {{ dd.alt_sel_txt }}){% endif %}</span></td></tr>
        <tr><td><span class="label label--small">Vitesse sol</span></td><td><span class="label label--small">{{ t.speed_txt }} km/h{% if dd.mach_txt != "" %} · Mach {{ dd.mach_txt }}{% endif %}</span></td></tr>
        {%- if dd.tas_txt and dd.tas_txt != "" -%}<tr><td><span class="label label--small">Vitesse air</span></td><td><span class="label label--small">{{ dd.tas_txt }} km/h</span></td></tr>{%- endif -%}
        {%- if dd.wind_txt and dd.wind_txt != "" -%}<tr><td><span class="label label--small">Vent</span></td><td><span class="label label--small" data-clamp="2">{{ dd.wind_txt }}, {{ dd.wind_effect_txt }}</span></td></tr>{%- endif -%}
        {%- if dd.oat_txt and dd.oat_txt != "" -%}<tr><td><span class="label label--small">Température ext.</span></td><td><span class="label label--small">{{ dd.oat_txt }}</span></td></tr>{%- endif -%}
        <tr><td><span class="label label--small">Cap · vario</span></td><td><span class="label label--small">{{ t.track_txt }}° · {{ t.vr_txt }} m/s</span></td></tr>
        {%- if dd.squawk_txt and dd.squawk_txt != "" -%}<tr><td><span class="label label--small">Transpondeur</span></td><td><span class="label label--small">{{ dd.squawk_txt }}</span></td></tr>{%- endif -%}
      </tbody></table>
    </div>
    {%- endunless -%}
  </div>
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">Radar du ciel</span>
  <span class="instance">{% if dd.photo and dd.photo != "" and narrow != true %}Photo : airport-data.com · {% endif %}{{ title_line }}</span>
</div>

{%- elsif mode == "suivi" and vue == "carte" -%}
{%- comment -%} ===================== CARTE DU SUIVI (MapLibre + tuiles TRMNL) ===================== {%- endcomment -%}
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<div class="layout layout--col">
  <div id="rc-map-{{ sz }}" class="map stretch w--full rounded--base">
    {%- unless short and narrow -%}
    <div id="rc-card-{{ sz }}" class="absolute top--2 left--2 z--2 {% if short or narrow %}p--2{% else %}p--4{% endif %} w--max-60 bg--canvas outline outline--muted">
      <div class="flex flex--col gap--small">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--small">{{ t.flight }}</span>
            <span class="label">{% if t.has_route %}{{ t.from }} – {{ t.to }} · {% endif %}{% if t.map_focus_txt and t.map_focus_txt != "" %}{{ t.map_focus_txt }}{% else %}{{ t.status_txt }}{% endif %}{% if t.progress_pct != nil %} · {{ t.progress_pct }} %{% endif %}</span>
          </div>
        </div>
        {%- if t.over_txt and t.over_txt != "" -%}
        <div class="divider"></div>
        <div class="flex flex--col">
          <span class="label label--small">Survole</span>
          <span class="title title--small" data-clamp="2">{{ t.over_txt }}</span>
        </div>
        {%- endif -%}
        {%- unless short or t.status == "attente" or t.status == "au_sol" -%}
        <div class="divider"></div>
        <table class="table table--condensed">
          <tbody>
            <tr><td><span class="label label--small">Altitude</span></td><td><span class="label label--small">{{ t.alt_txt }} m</span></td></tr>
            <tr><td><span class="label label--small">Vitesse</span></td><td><span class="label label--small">{{ t.speed_txt }} km/h</span></td></tr>
            {%- if t.eta_txt != "" -%}<tr><td><span class="label label--small">Arrivée</span></td><td><span class="label label--small">vers {{ t.eta_txt }}</span></td></tr>{%- endif -%}
            {%- if t.remaining_km and t.remaining_km > 0 -%}<tr><td><span class="label label--small">Reste</span></td><td><span class="label label--small">{{ t.remaining_txt }} km</span></td></tr>{%- endif -%}
            {%- if t.type != "" -%}<tr><td><span class="label label--small">Avion</span></td><td><span class="label label--small">{{ t.type }}</span></td></tr>{%- endif -%}
          </tbody>
        </table>
        {%- endunless -%}
      </div>
    </div>
    {%- endunless -%}
  </div>
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">Radar du ciel</span>
  <span class="instance">{{ title_line }}</span>
</div>
<script type="text/javascript">
(function () {
  var el = "rc-map-{{ sz }}", cardId = "rc-card-{{ sz }}";
  var done = {{ t.map_done_js | default: "[]" }}, todo = {{ t.map_todo_js | default: "[]" }};
  var pos = {{ t.map_pos_js | default: "null" }}, from = {{ t.map_from_js | default: "null" }}, to = {{ t.map_to_js | default: "null" }};
  var heading = {{ t.map_heading | default: 0 }};
  var focus = {{ t.map_focus_js | default: "null" }};
  function whenReady(cb) {
    var tries = 0;
    (function attempt() {
      if (window.TRMNLMaps && window.maplibregl) return cb();
      if (++tries > 200) return;
      setTimeout(attempt, 50);
    })();
  }
  // Silhouette d'avion (pointe vers le haut) dessinée de façon synchrone,
  // pour qu'elle soit prête avant que le framework ne prenne la capture.
  var PLANE = "M12 1.5c.9 0 1.5.8 1.5 1.7V9l8 4.6v2.3l-8-2.4v4.8l2.4 1.8V22L12 21l-3.9 1v-1.9l2.4-1.8v-4.8l-8 2.4v-2.3l8-4.6V3.2c0-.9.6-1.7 1.5-1.7z";
  function addPlane(map, size) {
    var px = Math.round(size), c = document.createElement("canvas");
    c.width = c.height = px;
    var ctx = c.getContext("2d");
    ctx.scale(px / 24, px / 24);
    var path = new Path2D(PLANE);
    ctx.lineJoin = "round"; ctx.lineWidth = 2.2; ctx.strokeStyle = "#fff"; ctx.stroke(path);
    ctx.fillStyle = "#000"; ctx.fill(path);
    if (!map.hasImage("rc-plane")) map.addImage("rc-plane", ctx.getImageData(0, 0, px, px));
    map.addSource("rc-plane", { type: "geojson", data: { type: "Feature", properties: {}, geometry: { type: "Point", coordinates: pos } } });
    map.addLayer({ id: "rc-plane", type: "symbol", source: "rc-plane", layout: {
      "icon-image": "rc-plane", "icon-rotate": heading, "icon-rotation-alignment": "map",
      "icon-allow-overlap": true, "icon-ignore-placement": true } });
  }
  whenReady(function () {
    TRMNLMaps.watch(el, function () {
      var map = new maplibregl.Map(TRMNLMaps.options({ el: el, preset: "{{ preset }}" }));
      map.on("load", function () {
        if (todo.length > 1) TRMNLMaps.route(map, todo, { el: el, id: "todo", i: done.length > 1 ? 1 : 0, n: 2 });
        if (done.length > 1) TRMNLMaps.route(map, done, { el: el, id: "done", i: 0, n: 2 });
        if (from) TRMNLMaps.dot(map, from, { el: el, id: "from" });
        if (to) TRMNLMaps.dot(map, to, { el: el, id: "to", hollow: true });
        if (pos) addPlane(map, TRMNLPaint.px({% if short or narrow %}26{% else %}36{% endif %}, { el: el }));
      });
      var pts = focus && focus.length ? focus.slice() : done.concat(todo);
      var maxZoom = focus && focus.length ? (focus.length === 1 ? 12 : 11) : 9;
      var home = [{{ home_lon | default: 2.17 }}, {{ home_lat | default: 43.988 }}];
      if (!(focus && focus.length)) {
        if (pos) pts.push(pos);
        if (from) pts.push(from);
        if (to) pts.push(to);
      }
      var gutter = TRMNLPaint.px(28, { el: el });
      var card = document.getElementById(cardId);
      var left = card ? card.offsetLeft + card.offsetWidth + gutter : gutter;
      if (pts.length) TRMNLMaps.fit(map, pts, { padding: { top: gutter, right: gutter, bottom: gutter, left: left }, maxZoom: maxZoom });
      else { map.setCenter(home); map.setZoom(4); }
      return map;
    });
  });
})();
</script>

{%- elsif mode != "suivi" and zvue == "carte" -%}
{%- comment -%} ===================== CARTE DU MODE ZONE ===================== {%- endcomment -%}
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
{%- assign zn = n -%}
<div class="layout layout--col">
  <div id="rc-zmap-{{ sz }}" class="map stretch w--full rounded--base">
    {%- unless short and narrow -%}
    <div id="rc-zcard-{{ sz }}" class="absolute {% if narrow %}bottom--2 left--2{% else %}top--2 left--2{% endif %} z--2 {% if short or narrow %}p--2{% else %}p--4{% endif %} w--max-60 bg--canvas outline outline--muted">
      <div class="flex flex--col gap--small">
        {%- if shown == 0 -%}
        <div class="item"><div class="meta"></div><div class="content">
          <span class="value value--small">Ciel calme</span>
          <span class="label">Aucun avion à {{ radius_km }} km</span>
        </div></div>
        {%- else -%}
        {%- for f in flights limit: zn -%}
        <div class="item">
          <div class="meta"><span class="index">{{ forloop.index }}</span></div>
          <div class="content">
            <span class="title title--small">{{ f.flight }}{% if f.has_route %} · {{ f.from }} – {{ f.to }}{% endif %}</span>
            {%- unless short -%}<span class="label label--small" data-clamp="1">{{ f.type }} · {{ f.alt_txt }} m · {{ f.dist_km }} km</span>{%- endunless -%}
          </div>
        </div>
        {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    {%- endunless -%}
  </div>
</div>
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">Radar du ciel</span>
  <span class="instance">{{ title_line }}</span>
</div>
<script type="text/javascript">
(function () {
  var el = "rc-zmap-{{ sz }}", cardId = "rc-zcard-{{ sz }}";
  var planes = ({{ map_flights_js | default: "[]" }}).filter(function (p) { return p[3] <= {{ n }}; }), circle = {{ map_circle_js | default: "[]" }};
  var home = [{{ home_lon | default: 2.17 }}, {{ home_lat | default: 43.988 }}];
  var PLANE = "M12 1.5c.9 0 1.5.8 1.5 1.7V9l8 4.6v2.3l-8-2.4v4.8l2.4 1.8V22L12 21l-3.9 1v-1.9l2.4-1.8v-4.8l-8 2.4v-2.3l8-4.6V3.2c0-.9.6-1.7 1.5-1.7z";
  function whenReady(cb) {
    var tries = 0;
    (function attempt() {
      if (window.TRMNLMaps && window.maplibregl) return cb();
      if (++tries > 200) return;
      setTimeout(attempt, 50);
    })();
  }
  function planeImage(px) {
    px = Math.round(px);
    var c = document.createElement("canvas"); c.width = c.height = px;
    var ctx = c.getContext("2d"); ctx.scale(px / 24, px / 24);
    var path = new Path2D(PLANE);
    ctx.lineJoin = "round"; ctx.lineWidth = 2.2; ctx.strokeStyle = "#fff"; ctx.stroke(path);
    ctx.fillStyle = "#000"; ctx.fill(path);
    return ctx.getImageData(0, 0, px, px);
  }
  whenReady(function () {
    TRMNLMaps.watch(el, function () {
      var map = new maplibregl.Map(TRMNLMaps.options({ el: el, preset: "{{ preset }}" }));
      map.on("load", function () {
        if (circle.length > 1) TRMNLMaps.route(map, circle, { el: el, id: "rayon", i: 1, n: 2 });
        TRMNLMaps.dot(map, home, { el: el, id: "maison", hollow: true });
        if (!planes.length) return;
        var size = TRMNLPaint.px({% if short or narrow %}24{% else %}32{% endif %}, { el: el });
        if (!map.hasImage("rc-plane")) map.addImage("rc-plane", planeImage(size));
        // Numéros des avions (pastilles noires), reliés à la liste de l'encadré
        var badge = TRMNLPaint.px({% if short or narrow %}16{% else %}20{% endif %}, { el: el });
        planes.forEach(function (p) {
          var id = "rc-n" + p[3];
          if (map.hasImage(id)) return;
          var px = Math.round(badge), c = document.createElement("canvas"); c.width = c.height = px;
          var ctx = c.getContext("2d");
          ctx.fillStyle = "#000"; ctx.beginPath(); ctx.arc(px / 2, px / 2, px / 2 - 1, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = "#fff"; ctx.font = "bold " + Math.round(px * 0.7) + "px sans-serif";
          ctx.textAlign = "center"; ctx.textBaseline = "middle"; ctx.fillText(String(p[3]), px / 2, px / 2 + 1);
          map.addImage(id, ctx.getImageData(0, 0, px, px));
        });
        map.addSource("rc-planes", { type: "geojson", data: { type: "FeatureCollection", features: planes.map(function (p) {
          return { type: "Feature", properties: { h: p[2], n: "rc-n" + p[3] }, geometry: { type: "Point", coordinates: [p[0], p[1]] } };
        }) } });
        map.addLayer({ id: "rc-planes", type: "symbol", source: "rc-planes", layout: {
          "icon-image": "rc-plane", "icon-rotate": ["get", "h"], "icon-rotation-alignment": "map",
          "icon-allow-overlap": true, "icon-ignore-placement": true } });
        map.addLayer({ id: "rc-planes-n", type: "symbol", source: "rc-planes", layout: {
          "icon-image": ["get", "n"], "icon-offset": [size * 0.75 / (window.devicePixelRatio || 1), -size * 0.75 / (window.devicePixelRatio || 1)],
          "icon-allow-overlap": true, "icon-ignore-placement": true } });
      });
      var gutter = TRMNLPaint.px(24, { el: el });
      var card = document.getElementById(cardId);
      var pad = { top: gutter, right: gutter, bottom: gutter, left: gutter };
      {% if narrow %}if (card) pad.bottom = card.offsetHeight + gutter * 1.5;{% else %}if (card) pad.left = card.offsetLeft + card.offsetWidth + gutter;{% endif %}
      var pts = circle.length ? circle.slice() : [home];
      planes.forEach(function (p) { pts.push([p[0], p[1]]); });
      TRMNLMaps.fit(map, pts, { padding: pad, maxZoom: 11 });
      return map;
    });
  });
})();
</script>

{%- elsif st == "led" -%}
{%- comment -%} ===================== STYLE LED ===================== {%- endcomment -%}
<div class="layout">
  <div class="rc rc--led rc--n{{ n }}{% if narrow %} rc--narrow{% endif %}{% if short %} rc--short{% endif %}">
  {%- if mode == "suivi" -%}
    <div class="led-head"><span>{{ t.flight }}</span><span>{{ t.status_txt }}</span></div>
    <div class="lt-route">
      <div><div class="lt-code">{{ t.from | default: "---" }}</div><div class="lt-city">{{ t.from_city }}</div></div>
      <div class="lt-mid">&gt;&gt;</div>
      <div class="lt-to"><div class="lt-code">{{ t.to | default: "---" }}</div><div class="lt-city">{{ t.to_city }}</div></div>
    </div>
    {%- if t.progress_pct != nil -%}
    <div class="lt-bar">{% for i in (1..30) %}<div class="lt-dot{% if i <= t.progress_steps %} lt-dot--on{% endif %}"></div>{% endfor %}</div>
    <div class="lt-info">{{ t.progress_pct }}%{% if t.remaining_km and t.remaining_km > 0 %} · reste {{ t.remaining_txt }} km{% endif %}{% if t.eta_txt != "" %} · arr. {{ t.eta_txt }}{% endif %}</div>
    {%- else -%}
    <div class="lt-info lt-info--alone">{% if t.status == "attente" %}en attente du transpondeur{% else %}route inconnue{% endif %}</div>
    {%- endif -%}
    {%- if t.over_txt and t.over_txt != "" -%}<div class="lt-over">sur {{ t.over_txt }}</div>{%- endif -%}
    <div class="lt-metrics">
      <div><span class="lt-k">alt m</span><span class="lt-v">{{ t.alt_txt }}</span></div>
      <div><span class="lt-k">km/h</span><span class="lt-v">{{ t.speed_txt }}</span></div>
      <div><span class="lt-k">cap</span><span class="lt-v">{{ t.track_txt }}</span></div>
      <div><span class="lt-k">vr m/s</span><span class="lt-v">{{ t.vr_txt }}</span></div>
    </div>
    <div class="led-foot"><span>{{ t.type | default: t.airline }}</span><span>{% if t.last_seen_txt != "" %}vu {{ t.last_seen_txt }}{% else %}{{ updated_txt }}{% endif %}</span></div>
  {%- else -%}
    <div class="led-head"><span>ciel de {{ place_short }}</span><span>{{ updated_txt }}</span></div>
    <div class="led-body">
    {%- if shown == 0 -%}
      <div class="led-empty">ciel calme<br>rien a {{ radius_km }} km</div>
    {%- else -%}
      {%- for f in flights limit: n -%}
      <div class="led-row">
        <div class="led-main"><span>{{ f.flight }}</span><span>{% if f.has_route %}{{ f.from }}&gt;{{ f.to }}{% else %}---&gt;---{% endif %}</span><span class="led-type">{{ f.type_code }}</span></div>
        <div class="led-sub">{% if short or narrow %}{{ f.alt_txt }}m {{ f.speed_txt }}kmh{% unless narrow %} cap {{ f.track_txt }}{% endunless %}{% else %}alt {{ f.alt_txt }}m &nbsp;{{ f.speed_txt }}kmh &nbsp;cap {{ f.track_txt }} &nbsp;vr {{ f.vr_txt }} &nbsp;{{ f.dist_km }}km{% endif %}</div>
      </div>
      {%- endfor -%}
    {%- endif -%}
    </div>
    <div class="led-foot"><span>adsb.lol</span><span>{{ total_n }} vol{% if total_n > 1 %}s{% endif %} · {{ radius_km }}km</span></div>
  {%- endif -%}
  </div>
</div>

{%- elsif st == "flip-flap" -%}
{%- comment -%} ===================== STYLE FLIP-FLAP ===================== {%- endcomment -%}
<div class="layout">
  {%- if mode == "suivi" -%}
  {%- assign tn = 7 -%}{%- if short -%}{%- assign tn = 3 -%}{%- endif -%}
  <div class="rc rc--flap rc--track rc--n{{ tn }}">
    <div class="fl-head"><span>suivi</span><span>{{ updated_txt }}</span></div>
    <div class="fl-body">
      {%- for line in t.flap limit: tn -%}
      <div class="fl-row">{%- assign chars = line | split: "" -%}{%- for c in chars -%}<div class="fl-tile">{{ c }}</div>{%- endfor -%}</div>
      {%- endfor -%}
    </div>
    <div class="fl-foot"><span>Données ADS-B : adsb.lol (ODbL)</span><span>{% if t.last_seen_txt != "" %}Vu à {{ t.last_seen_txt }}{% endif %}</span></div>
  </div>
  {%- else -%}
  {%- assign fcols = 28 -%}{%- if narrow -%}{%- assign fcols = 20 -%}{%- endif -%}
  <div class="rc rc--flap rc--n{{ n }}{% if narrow %} rc--narrow{% endif %}">
    <div class="fl-head"><span>{% if narrow %}survols{% else %}survols · {{ place_short }}{% endif %}</span><span>{{ updated_txt }}</span></div>
    <div class="fl-labels"><span class="c1">vol</span><span class="c2">de</span><span class="c3">vers</span><span class="c4">alt m</span>{% unless narrow %}<span class="c5">km/h</span><span class="c6">cap</span>{% endunless %}</div>
    <div class="fl-body">
      {%- for f in flights limit: n -%}
      {%- if narrow -%}{%- assign fline = f.flap_short -%}{%- else -%}{%- assign fline = f.flap -%}{%- endif -%}
      <div class="fl-row">{%- assign chars = fline | split: "" -%}{%- for c in chars -%}<div class="fl-tile">{{ c }}</div>{%- endfor -%}</div>
      {%- endfor -%}
      {%- if shown == 0 -%}
      {%- assign blanks = blanks | minus: 1 -%}
      <div class="fl-row">{%- if narrow -%}{%- assign calm = "    CIEL  CALME     " -%}{%- else -%}{%- assign calm = "         CIEL  CALME        " -%}{%- endif -%}{%- assign chars = calm | split: "" -%}{%- for c in chars -%}<div class="fl-tile">{{ c }}</div>{%- endfor -%}</div>
      {%- endif -%}
      {%- for i in (1..blanks) -%}
      <div class="fl-row">{%- for j in (1..fcols) -%}<div class="fl-tile"></div>{%- endfor -%}</div>
      {%- endfor -%}
    </div>
    <div class="fl-foot"><span>{% if narrow %}adsb.lol{% else %}Données ADS-B : adsb.lol (ODbL){% endif %}</span><span>{{ total_n }} vol{% if total_n > 1 %}s{% endif %} · {{ radius_km }} km</span></div>
  </div>
  {%- endif -%}
</div>

{%- else -%}
{%- comment -%} ===================== STYLE CLASSIQUE (framework TRMNL) ===================== {%- endcomment -%}
{%- if mode == "suivi" -%}
<div class="layout layout--col gap{% unless short %}--medium{% endunless %}">
  <div class="flex flex--row flex--center-y flex--between w--full">
    <div class="flex flex--col">
      <span class="value {% if short or narrow %}value--large{% else %}value--xxlarge{% endif %}">{{ t.from | default: "---" }}</span>
      {% unless short %}<span class="label" data-clamp="1">{{ t.from_city }}</span>{% endunless %}
    </div>
    <div class="flex flex--col flex--center-x gap--small">
      <span class="title{% if narrow %} title--small{% endif %}">{{ t.flight }}</span>
      <span class="label label--inverted">{{ t.status_txt }}</span>
    </div>
    <div class="flex flex--col text--right">
      <span class="value {% if short or narrow %}value--large{% else %}value--xxlarge{% endif %}">{{ t.to | default: "---" }}</span>
      {% unless short %}<span class="label" data-clamp="1">{{ t.to_city }}</span>{% endunless %}
    </div>
  </div>
  {%- if t.progress_pct != nil -%}
  <div class="progress-bar{% unless short %} progress-bar--large{% endunless %} w--full"><div class="track"><div class="fill bg--black" style="width: {{ t.progress_pct }}%"></div></div></div>
  <span class="label text--center">{{ t.progress_pct }} %{% if t.remaining_km and t.remaining_km > 0 %} · {{ t.remaining_txt }} km restants{% endif %}{% if t.eta_txt != "" %} · arrivée vers {{ t.eta_txt }}{% endif %}</span>
  {%- else -%}
  <span class="label text--center">{% if t.status == "attente" %}Le vol apparaîtra dès que son transpondeur émettra{% else %}Route inconnue{% endif %}</span>
  {%- endif -%}
  {%- if t.over_txt and t.over_txt != "" -%}<span class="label text--center" data-clamp="1">Survole : {{ t.over_txt }}</span>{%- endif -%}
  {%- if t.route_doubt -%}<span class="label label--small text--center">Route incertaine : l'avion s'écarte du trajet prévu</span>{%- endif -%}
  {%- unless short or t.status == "attente" -%}
  <div class="divider"></div>
  <div class="grid grid--cols-{% if narrow %}2{% else %}4{% endif %}">
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--small">{{ t.alt_txt }}</span><span class="label">Altitude (m)</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--small">{{ t.speed_txt }}</span><span class="label">Vitesse (km/h)</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--small">{{ t.track_txt }}°</span><span class="label">Cap</span></div></div>
    <div class="item"><div class="meta"></div><div class="content"><span class="value value--small">{{ t.vr_txt }}</span><span class="label">Vertical (m/s)</span></div></div>
  </div>
  {%- endunless -%}
</div>
{%- else -%}
<div class="layout layout--col layout--top layout--stretch-x gap--small">
  {%- if shown == 0 -%}
  <div class="flex flex--col flex--center gap h--full w--full">
    <span class="value value--large">Ciel calme</span>
    <span class="label">Aucun avion à moins de {{ radius_km }} km</span>
  </div>
  {%- else -%}
  {%- for f in flights limit: n -%}
  {%- capture route_txt -%}{% if f.has_route %}{{ f.from }} – {{ f.to }}{% else %}– – –{% endif %}{%- endcapture -%}
  {%- capture who_txt -%}{{ f.type }}{% if f.airline != "" %} · {{ f.airline }}{% endif %}{%- endcapture -%}
  {%- if narrow -%}
  <div class="flex flex--col flex--left w--full">
    <div class="flex flex--row flex--between w--full flex--center-y">
      <span class="value value--small">{{ f.flight }}</span>
      <span class="value value--small">{{ route_txt }}</span>
    </div>
    <span class="label label--small" data-clamp="1">{{ who_txt }}</span>
    <span class="label label--small">{{ f.alt_txt }} m · {{ f.speed_txt }} km/h · {{ f.dist_km }} km</span>
  </div>
  {%- else -%}
  <div class="grid grid--cols-12 w--full">
    <div class="col--span-4 flex flex--col flex--left">
      <span class="value value--small">{{ f.flight }}</span>
      <span class="label label--small" data-clamp="1">{{ who_txt }}</span>
    </div>
    <div class="col--span-4 flex flex--col flex--left">
      <span class="value value--small">{{ route_txt }}</span>
      <span class="label label--small" data-clamp="1">{% if f.has_route %}{{ f.from_city }} – {{ f.to_city }}{% else %}Route inconnue{% endif %}</span>
    </div>
    <div class="col--span-4 flex flex--col flex--right text--right">
      <span class="label">{{ f.alt_txt }} m · {{ f.speed_txt }} km/h</span>
      <span class="label label--small">cap {{ f.track_txt }}° · {{ f.vr_txt }} m/s · {{ f.dist_km }} km</span>
    </div>
  </div>
  {%- endif -%}
  {%- unless forloop.last -%}<div class="divider"></div>{%- endunless -%}
  {%- endfor -%}
  {%- endif -%}
</div>
{%- endif -%}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">Radar du ciel</span>
  <span class="instance">{{ title_line }}</span>
</div>
{%- endif -%}
