{%- elsif mode == "suivi" and vue == "carte" -%}
{%- comment -%} ===================== CARTE DU SUIVI (MapLibre + tuiles TRMNL) ===================== {%- endcomment -%}
<script src="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<link href="https://trmnl.com/js/maplibre-gl/5.24.0/maplibre-gl.css" rel="stylesheet">
<div class="layout layout--col">
  <div id="rc-map-{{ sz }}" class="map stretch w--full rounded--base">
    {%- unless short and narrow -%}
    <div id="rc-card-{{ sz }}" class="absolute top--2 left--2 z--2 {% if short or narrow %}p--2{% else %}p--4{% endif %} w--max-60 bg--canvas outline outline--muted">
      <div class="flex flex--col gap--small">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            {%- if t.logo and t.logo != "" -%}<img class="rc-logo" src="{{ t.logo }}">{%- endif -%}
            <span class="value value--small">{{ t.flight }}</span>
            <span class="label">{% if t.has_route %}{{ t.from }} – {{ t.to }} · {% endif %}{% if t.map_focus_txt and t.map_focus_txt != "" %}{{ t.map_focus_txt }}{% else %}{{ t.status_txt }}{% endif %}{% if t.progress_pct != nil %} · {{ t.progress_pct }} %{% endif %}</span>
            {%- if t.pos_estimated and t.fix_txt != "" -%}<span class="label label--small">Dernier signal à {{ t.fix_txt }}</span>{%- endif -%}
            {%- if t.arr and t.arr.time_txt -%}<span class="label label--small" data-clamp="1">{{ t.arr.city }} : {{ t.arr.time_txt }}{% if t.arr.temp_txt and t.arr.temp_txt != "" %} · {{ t.arr.temp_txt }}, {{ t.arr.wx_txt }}{% endif %}</span>{%- endif -%}
          </div>
