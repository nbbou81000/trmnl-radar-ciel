      <div><span class="label label--small">Types d'avions</span><span class="value value--tnums">{{ cb.types | default: 0 }}</span>{% unless short %}<span class="label label--small">sur {{ cb.types_total }} connus</span><div class="rc-bar"><div class="rc-bar__fill" style="width: {{ cb.types_pct }}%"></div></div>{% endunless %}</div>
