      {%- endif -%}
      {%- for f in flights limit: n -%}{%- if f.sky_x and f.el > -1 -%}
      <g transform="translate({{ f.sky_x }} {{ f.sky_y }})">
        <g transform="rotate({{ f.track_deg | default: 0 }}) scale(1.7)"><path d="{{ plane_path }}" fill="#000" stroke="#fff" stroke-width="0.9" stroke-linejoin="round"/></g>
        <circle cx="19" cy="-19" r="11" fill="#000"/><text x="19" y="-14" text-anchor="middle" fill="#fff" font-family="Inter, sans-serif" font-size="14" font-weight="700">{{ forloop.index }}</text>
      </g>
      {%- endif -%}{%- endfor -%}
    </svg>
    <div class="rc-ciel__side">
      {{ rare_banner }}
      {%- unless short -%}
      {%- if shown == 0 -%}
      <span class="value value--small">Ciel calme</span><span class="label">Aucun avion à {{ radius_km }} km</span>
      {%- else -%}
      {%- assign others = shown | minus: cn -%}
      {%- for f in flights limit: cn -%}
      <div class="rc-ciel__item">
        <span class="rc-badge">{{ forloop.index }}</span>
        <div class="rc-ciel__txt">
          <div class="rc-ciel__line">{%- if f.logo and f.logo != "" -%}<img class="rc-logo" src="{{ f.logo }}">{%- endif -%}<span class="title title--small">{{ f.flight }}{% if f.has_route %} · {{ f.from }} – {{ f.to }}{% endif %}</span></div>
          <span class="label label--small" data-clamp="1">{% if f.el < 0 %}sous l'horizon{% else %}{{ f.dir_txt | capitalize }}, {{ f.el }}°{% endif %}{% if f.trend_txt != "" %} · {{ f.trend_txt }}{% endif %}{% if f.has_route %} · {{ f.from_city }} → {{ f.to_city }}{% endif %}</span>
        </div>
      </div>
      {%- endfor -%}
      {%- if others > 0 -%}<span class="label label--small">et {{ others }} autre{% if others > 1 %}s{% endif %} sur la carte du ciel</span>{%- endif -%}
      {%- endif -%}
      {%- endunless -%}
      {%- if next_pass -%}
      <div class="rc-ciel__next">
        <span class="label label--small">Prochain passage au plus près</span>
        <span class="value {% if short or narrow %}value--xsmall{% else %}value--small{% endif %}">{{ next_pass.in_txt }}{% if next_pass.zenith %} · presque à la verticale{% endif %}</span>
        <div class="rc-ciel__line">{%- if next_pass.logo != "" and narrow != true -%}<img class="rc-logo" src="{{ next_pass.logo }}">{%- endif -%}<span class="label" data-clamp="1">{{ next_pass.flight }}{% if next_pass.type != "" %} · {{ next_pass.type }}{% endif %} · {{ next_pass.el_max }}° au {{ next_pass.dir_txt }}</span></div>
      </div>
      {%- endif -%}
