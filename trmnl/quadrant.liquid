          <span class="title title--small" data-clamp="2">{{ t.over_txt }}</span>
        </div>
        {%- endif -%}
        {%- unless short or t.status == "attente" or t.status == "au_sol" -%}
        <div class="divider"></div>
        <table class="table table--condensed">
          <tbody>
            <tr><td><span class="label label--small">Altitude</span></td><td><span class="label label--small">{{ t.alt_txt }} m</span></td></tr>
            <tr><td><span class="label label--small">Vitesse</span></td><td><span class="label label--small">{{ t.speed_txt }} km/h</span></td></tr>
            {%- if t.eta_txt != "" -%}<tr><td><span class="label label--small">Arrivée</span></td><td><span class="label label--small">vers {{ t.eta_txt }}</span></td></tr>{%- endif -%}
            {%- if t.remaining_km and t.remaining_km > 0 -%}<tr><td><span class="label label--small">Reste</span></td><td><span class="label label--small">{{ t.remaining_txt }} km</span></td></tr>{%- endif -%}
            {%- if t.type != "" -%}<tr><td><span class="label label--small">Avion</span></td><td><span class="label label--small">{{ t.type }}</span></td></tr>{%- endif -%}
