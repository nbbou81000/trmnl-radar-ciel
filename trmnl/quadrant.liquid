    <div class="flex flex--col">
      <span class="value {% if narrow %}value--small{% else %}value--medium{% endif %}">{{ t.flight }}{% if t.has_route %} · {{ t.from }} – {{ t.to }}{% endif %}</span>
      <span class="label" data-clamp="1">{{ dd.airline }}{% if dd.callsign != "" %} · {{ dd.callsign }}{% endif %}</span>
    </div>
    </div>
    <div class="flex flex--col text--right flex--right">
      <span class="label label--inverted">{% if dd.emergency %}URGENCE {{ dd.squawk_txt }}{% else %}{{ t.status_txt }}{% endif %}</span>
      {% if t.route_doubt %}<span class="label label--small">route incertaine</span>{% elsif t.progress_pct != nil %}<span class="label label--small">{{ t.progress_pct }} % du trajet</span>{% endif %}
    </div>
