      <circle cx="200" cy="200" r="113" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="4 7"/>
      <circle cx="200" cy="200" r="57" fill="none" stroke="#000" stroke-width="1.5" stroke-dasharray="4 7"/>
      <line x1="30" y1="200" x2="370" y2="200" stroke="#000" stroke-width="1" stroke-dasharray="2 8"/>
      <line x1="200" y1="30" x2="200" y2="370" stroke="#000" stroke-width="1" stroke-dasharray="2 8"/>
      <g font-family="Inter, sans-serif" font-weight="700" font-size="22" text-anchor="middle">
        <text x="200" y="22">N</text><text x="388" y="208">E</text><text x="200" y="396">S</text><text x="12" y="208">O</text>
      </g>
      <g font-family="Inter, sans-serif" font-size="13"><text x="205" y="83">60°</text><text x="205" y="140">30°</text></g>
      <circle cx="200" cy="200" r="4" fill="#000"/>
