        {%- if cb.longest -%}<span class="label label--small rc-gap">Plus longue route</span><span class="title title--small" data-clamp="1">{{ cb.longest.txt }} · {{ cb.longest.km_txt }} km</span>{%- endif -%}
        {%- if cb.news.size > 0 -%}<span class="label label--small rc-gap">Nouveaux dans la collection</span><span class="label" data-clamp="2">{{ cb.news | join: " · " }}</span>{%- endif -%}
