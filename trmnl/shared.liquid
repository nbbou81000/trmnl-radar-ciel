  .rc-arr.rc--narrow .rc-arr__foot { flex-direction: column; }
  .rc-arr.rc--short .rc-arr__profile { height: 22cqh; }
  .rc-arr.rc--short .rc-wx { width: 36px; height: 36px; }
  /* Collection d'avions */
  .rc-coll { display: flex; flex-direction: column; gap: 2.2cqh; }
  .rc-coll__head { display: flex; align-items: center; gap: 2cqw; padding-bottom: 1.6cqh; border-bottom: 1px dashed #000; }
