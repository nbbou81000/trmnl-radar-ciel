  .rc-ciel__item { display: flex; gap: 10px; align-items: flex-start; }
  .rc-ciel__txt { display: flex; flex-direction: column; min-width: 0; }
  .rc-ciel__next, .rc-ciel__iss { display: flex; flex-direction: column; gap: 3px; border-top: 1px dashed #000; padding-top: 1.8cqh; }
  .rc-ciel.rc--narrow { grid-template-columns: 1fr; grid-template-rows: 56cqh 1fr; gap: 2cqh; justify-items: center; }
