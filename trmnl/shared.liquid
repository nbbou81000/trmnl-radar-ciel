  .rc-bar { height: 8px; border: 1.5px solid #000; margin-top: 4px; }
  .rc-bar__fill { height: 100%; background: #000; }

  /* ---------- Vol et arrivée ---------- */
  .rc-arr { display: flex; flex-direction: column; gap: 2cqh; }
  .rc-arr__head { display: flex; align-items: center; gap: 2cqw; }
  .rc-arr__id { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .rc-arr__profile { position: relative; height: 26cqh; padding-bottom: 20px; border-top: 1px dashed #000; padding-top: 1.5cqh; }
  .rc-arr__profile svg { width: 100%; height: 100%; }
  .rc-arr__dot { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: #000; border: 2px solid #fff; translate: 0 1.5cqh; }
  .rc-arr__axis { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; }
  .rc-arr__dest { display: grid; grid-template-columns: auto 1fr; gap: 4cqw; align-items: center; border-top: 1px dashed #000; padding-top: 2cqh; }
  .rc-arr__time { display: flex; flex-direction: column; }
  .rc-arr__wx { display: flex; align-items: center; gap: 2cqw; min-width: 0; }
  .rc-wx { width: 64px; height: 64px; flex-shrink: 0; }
  .rc-arr__wxtxt { display: flex; flex-direction: column; min-width: 0; }
  .rc-arr__foot { display: flex; justify-content: space-between; gap: 2cqw; border-top: 1px dashed #000; padding-top: 1.5cqh; margin-top: auto; }
  .rc-arr.rc--narrow .rc-arr__dest { grid-template-columns: 1fr; gap: 1.5cqh; }
  .rc-arr.rc--narrow .rc-arr__head { flex-wrap: wrap; justify-content: space-between; row-gap: 1cqh; }
