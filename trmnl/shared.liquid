<style>
  /* ---------- Logos, bandeau « rare » ---------- */
  .rc-logo { height: 18px; width: auto; max-width: 120px; object-fit: contain; flex-shrink: 0; }
  .rc-logo--big { height: 34px; max-width: 170px; }
  .screen--lg .rc-logo { height: 26px; max-width: 170px; } .screen--lg .rc-logo--big { height: 50px; max-width: 250px; }
  .rc-ciel__line { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .rc-logo--small { height: 13px; max-width: 90px; }
  .screen--lg .rc-logo--small { height: 18px; max-width: 120px; }
  .rc-rare { font-family: "Inter Variable", Inter, "Helvetica Neue", Arial, sans-serif; display: flex; align-items: center; gap: 10px; background: #000; color: #fff; border-radius: 8px; padding: 5px 10px; width: 100%; box-sizing: border-box; }
  .rc-rare__tag { font-weight: 800; letter-spacing: .08em; font-size: 15px; }
  .rc-rare__txt { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rc-badge { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #000; color: #fff; font-weight: 700; font-size: 13px; flex-shrink: 0; }

  /* ---------- Où regarder ---------- */
  .rc-ciel { display: grid; grid-template-columns: 100cqh 1fr; gap: 3cqw; align-items: stretch; }
  .rc-ciel .rc-sky { width: 100cqh; height: 100cqh; }
