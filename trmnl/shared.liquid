  .rc-h { font: 700 12px/1.2 Inter, sans-serif; text-transform: uppercase; letter-spacing: .06em; border-bottom: 2px solid #000; padding-bottom: 2px; margin-bottom: 3px; }
  .rc-rec { display: flex; flex-direction: column; margin-bottom: 4px; min-width: 0; }
  .rc-rec__v { font-family: "Oswald", sans-serif; font-size: 22px; line-height: 1.05; }
