  .rc-vbar__l { font: 400 9px/1.1 Inter, sans-serif; text-align: center; white-space: nowrap; }
  .screen--lg .rc-h { font-size: 20px; } .screen--lg .rc-rec__v { font-size: 38px; }
  .screen--lg .rc-hbar { grid-template-columns: 120px 1fr 54px; height: 36px; } .screen--lg .rc-hbar--txt { grid-template-columns: 44% 1fr 60px; height: 30px; }
  .screen--lg .rc-hbar__name, .screen--lg .rc-hbar__n { font-size: 20px; } .screen--lg .rc-hbar__track { height: 18px; }
  .screen--lg .rc-vbars { height: 190px; } .screen--lg .rc-vbars--dow { height: 130px; } .screen--lg .rc-vbar__n { font-size: 17px; } .screen--lg .rc-vbar__l { font-size: 15px; }
  .screen--lg .rc-rose { max-width: 300px; }
</style>
